{
    "description": "Career progression paths and skill requirements across multiple fields",
    "software_engineering": {
        "path": "Junior Developer → Mid-Level Developer → Senior Developer → Staff/Principal Engineer",
        "typical_timeline": "7-10 years to reach senior level",
        "progression": {
            "junior_to_mid": {
                "time_needed": "2-3 years",
                "skills_to_develop": [
                    "Master 2-3 programming languages deeply",
                    "Understanding of system design basics",
                    "Write comprehensive tests",
                    "Code review skills",
                    "Debugging complex issues independently",
                    "Contribute to technical decisions"
                ],
                "experience_needed": [
                    "Shipped 3+ production features",
                    "Fixed production bugs",
                    "Participated in on-call rotation",
                    "Mentored at least 1 junior"
                ]
            },
            "mid_to_senior": {
                "time_needed": "3-5 years",
                "skills_to_develop": [
                    "Advanced system design and architecture",
                    "Technical leadership and influence",
                    "Breaking down large projects",
                    "Cross-team collaboration",
                    "Technical strategy and trade-offs",
                    "Interviewing and hiring"
                ],
                "experience_needed": [
                    "Led multi-month projects end-to-end",
                    "Designed systems used by multiple teams",
                    "Mentored 3+ engineers to promotion",
                    "Made architectural decisions with org impact",
                    "Improved team processes"
                ]
            }
        }
    },
    "ai_ml_engineering": {
        "path": "Software Engineer → ML Engineer → Senior ML Engineer → ML Architect/Research Scientist",
        "typical_timeline": "5-8 years (requires strong SWE foundation first)",
        "prerequisites": "Most AI/ML roles require 2-5 years SWE experience BEFORE transitioning",
        "progression": {
            "swe_to_ml": {
                "time_needed": "1-2 years of dedicated ML learning + projects",
                "skills_to_develop": [
                    "Strong Python and data structures",
                    "Linear algebra, calculus, statistics",
                    "ML fundamentals (supervised, unsupervised, reinforcement)",
                    "Deep learning frameworks (TensorFlow, PyTorch)",
                    "Model evaluation and validation",
                    "Feature engineering"
                ],
                "projects_needed": [
                    "3+ ML projects with real data",
                    "At least 1 deployed ML model",
                    "Kaggle or research competitions (optional but helpful)",
                    "OpenAI/Hugging Face contributions"
                ]
            },
            "junior_ml_to_mid": {
                "time_needed": "2-4 years",
                "skills_to_develop": [
                    "MLOps and model deployment",
                    "Distributed training",
                    "Model optimization and compression",
                    "A/B testing for ML",
                    "Production ML monitoring",
                    "Cloud ML platforms (Sagemaker, Vertex AI)"
                ],
                "experience_needed": [
                    "Built and deployed 5+ ML models to production",
                    "Improved model performance by measurable amount",
                    "Set up ML pipelines",
                    "Handled data drift and model retraining"
                ]
            },
            "mid_to_senior_ml": {
                "time_needed": "3-5 years",
                "skills_to_develop": [
                    "ML system architecture",
                    "Research to production pipeline",
                    "Team and project leadership",
                    "Strategic ML roadmapping",
                    "State-of-the-art techniques (LLMs, etc.)",
                    "Cross-functional stakeholder management"
                ],
                "experience_needed": [
                    "Led ML team or major ML initiative",
                    "Designed ML architectures for company products",
                    "Published research or patents (bonus)",
                    "Measurable business impact from ML work"
                ]
            }
        },
        "reality_check": "Entry-level 'AI Engineer' jobs are extremely rare. Most require 3+ years experience. Start as SWE or Data Analyst, then transition."
    },
